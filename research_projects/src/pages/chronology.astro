---
import BaseLayout from '../layouts/BaseLayout.astro';
import TermIndex from '../components/TermIndex.astro';
import { CHRONOLOGY } from '../data/index-terms.mjs';

const toItem = (t) => ({ label: t.label, query: t.query || t.label });
const groups = [{ name: 'Heat waves in history', items: CHRONOLOGY.map(toItem) }];
---

<BaseLayout title="Chronology · Research Projects">
  <TermIndex
    title="Chronology"
    titleJa="年表"
    note="Events across the pages, in time order. Click one to run a semantic search."
    groups={groups}
    primaryLabel="By date"
  />
</BaseLayout>
